{
  "manifest_version": 3,
  "name": "yt-dlp Audio",
  "version": "1.0.0",
  "description": "One-click best-quality YouTube audio downloads.",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "notifications"
  ],
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "preferred_environment": ["service_worker", "document"]
  },
  "action": {
    "default_title": "Download YouTube audio"
  },
  "icons": {
    "128": "icons/audio-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "data_collection_permissions": {
        "required": ["none"]
      },
      "id": "yt-dlp-audio@broken.local",
      "strict_min_version": "136.0"
    }
  }
}
