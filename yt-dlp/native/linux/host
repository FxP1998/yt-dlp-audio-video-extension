#!/usr/bin/env python3
"""Native Messaging bridge from the browser extensions to the downloader."""

import json
import re
import struct
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit


CALLERS = {
    "yt-dlp-audio@broken.local": "audio",
    "chrome-extension://kbcjajcfgfmnajlbbngooeamocbbhigm/": "audio",
    "yt-dlp-video@broken.local": "video",
    "chrome-extension://inonagcohgljchagbchjolfdfflokokc/": "video",
}
MAX_MESSAGE_SIZE = 1024 * 1024
PROGRESS_RE = re.compile(r"\[download\]\s+(\d+(?:\.\d+)?)%")
SCRIPT = Path(__file__).resolve().parents[2] / "bin" / "download"


def read_message():
    header = sys.stdin.buffer.read(4)
    if not header:
        return None
    if len(header) != 4:
        raise ValueError("Incomplete native message header")
    (length,) = struct.unpack("=I", header)
    if length > MAX_MESSAGE_SIZE:
        raise ValueError("Native message is too large")
    payload = sys.stdin.buffer.read(length)
    if len(payload) != length:
        raise ValueError("Incomplete native message")
    return json.loads(payload.decode("utf-8"))


def send_message(message):
    payload = json.dumps(message, separators=(",", ":")).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("=I", len(payload)))
    sys.stdout.buffer.write(payload)
    sys.stdout.buffer.flush()


def validate_url(value):
    if not isinstance(value, str) or len(value) > 8192:
        return False
    try:
        url = urlsplit(value)
        host = (url.hostname or "").lower()
        return (
            url.scheme == "https"
            and url.username is None
            and url.password is None
            and url.port in (None, 443)
            and (host == "youtu.be" or host == "youtube.com" or host.endswith(".youtube.com"))
            and bool(url.path)
        )
    except ValueError:
        return False


def run_download(mode, url):
    if mode not in ("audio", "video") or not validate_url(url):
        send_message({"status": "error", "message": "Please open a YouTube video first."})
        return
    if not SCRIPT.is_file():
        send_message({"status": "error", "message": "The yt-dlp download script was not found."})
        return

    send_message({"status": "started", "mode": mode})
    try:
        process = subprocess.Popen(
            [str(SCRIPT), mode, url],
            cwd=str(SCRIPT.parent),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            encoding="utf-8",
            errors="replace",
            bufsize=1,
        )
        last_progress = None
        last_lines = []
        assert process.stdout is not None
        for line in process.stdout:
            line = line.strip()
            if not line:
                continue
            last_lines.append(line)
            last_lines = last_lines[-5:]
            match = PROGRESS_RE.search(line)
            if match:
                percent = min(100, int(float(match.group(1))))
                if percent != last_progress:
                    send_message({"status": "progress", "percent": percent})
                    last_progress = percent
        return_code = process.wait()
    except OSError as error:
        send_message({"status": "error", "message": str(error)[:300]})
        return

    if return_code == 0:
        send_message({"status": "complete"})
    else:
        detail = next(
            (line for line in reversed(last_lines) if "ERROR:" in line),
            "yt-dlp exited with status " + str(return_code),
        )
        send_message({"status": "error", "message": detail[:300]})


def main():
    allowed_mode = next(
        (CALLERS[argument] for argument in sys.argv[1:] if argument in CALLERS),
        None,
    )
    while True:
        try:
            message = read_message()
        except (UnicodeDecodeError, json.JSONDecodeError, ValueError):
            return 1
        if message is None:
            return 0
        if allowed_mode is None:
            send_message({"status": "error", "message": "This extension is not allowed."})
            continue
        if not isinstance(message, dict):
            send_message({"status": "error", "message": "Invalid request."})
            continue
        run_download(allowed_mode, message.get("url"))


if __name__ == "__main__":
    sys.exit(main())
